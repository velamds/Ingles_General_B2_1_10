df", "content": "engenn9le10ob04re7pdf01.pdf"}]}]}], "template_override": 1, "id": 11, "_data": [{"type": "instructions", "contents": [{"type": "text", "content": " \nRole play an interview\n"}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Take Away"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"type": "learning_skills", "contents": [{"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Speaking"}]}, {"type": "post_instructions", "contents": [{"type": "text", "content": "\nInstructions: Complete the following steps. Fill in the Self Assessment.\n"}]}]}], "type": "scholar", "_data": [{"type": "lab_options", "contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}]}], "id": 0, "stimuli": [{"type": "welcome", "template_override": 1, "_data": [], "id": 0, "contents": [{}]}, {"contents": [{"type": "slideshow", "value": {"coverimg": "engenn9le10ob04re2img05.jpg", "audiosrc": "engenn9le10ob04re2aud01", "images": [{"time": "0", "image": "engenn9le10ob04re2img05.jpg", "text": "", "id": 0}, {"time": "100", "image": "engenn9le10ob04re2img05.jpg", "text": "<span class= \"strong\"> Adam</span>: Kristi, I was just approached by a recruitment agency. They told me they were looking for someone to fill a new position. <br />\n<span class= \"strong\"> Kristi</span>: That's great, Adam. How did it go?<br />\n<span class= \"strong\"> Adam</span>: I was very nervous and it was a difficult interview. It was my first interview here. <br />\n<span class= \"strong\"> Kristi</span>: You're such a composed guy. <br />\n<span class= \"strong\"> Adam</span>: I felt like there was a frog in my throat. My heart was beating a mile a minute.<br />\n<span class= \"strong\"> Kristi</span>: You're funny. Tell me more about the interview. <br />", "id": 1}, {"time": "25500", "image": "engenn9le10ob04re2img06.jpg", "text": "<span class= \"strong\"> Adam</span>: They said it was an interview for a full-time position. Most of my experience has been with part-time jobs.<br />\n<span class= \"strong\"> Kristi</span>: I see. What kind of questions did they ask you? <br />\n<span class= \"strong\"> Adam</span>: They asked me what my strengths and weaknesses were. I may have come off as a little overconfident. I tried toohard to impress and never mentioned any weaknesses. <br />\n<span class= \"strong\"> Kristi</span>: Uh oh. You don't want to be a blowhard. A recruiter told me it's good to be modest and have a quiet confidence. <br />\n<span class= \"strong\"> Adam</span>: They asked why I'd left my last job. They put me on the spot! <br />\n<span class= \"strong\"> Kristi</span>: What did you say?<br />", "id": 2}, {"time": "59000", "image": "engenn9le10ob04re2img07.jpg", "text": "<span class= \"strong\"> Adam</span>: I tried not to beat around the bush. I told them straight out that I left because my ex-boss was a jerk. <br />\n<span class= \"strong\"> Kristi</span>: Ouch! It's okay to be honest about what happened. But don't offer up any negative details. It doesn't look good on you. <br />\n<span class= \"strong\"> Adam</span>: I know. Needless to say, that was not my best interview. But you live and learn. <br />\n<span class= \"strong\"> Kristi</span>: That's the spirit. There are tons of jobs out there, so roll up your sleeves and let's get busy. I will do some research and help you with your interviews. I will also be helping me as I have a few coming up. <br />\n<span class= \"strong\"> Adam</span>: Thanks again, Kristi. <br />", "id": 3}]}}], "template_override": 1, "title": "", "type": "audio", "id": 1, "_data": []}]}], "_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "Persistence is Key"}, {"type": "unit_name", "content": "Go For It"}, {"type": "position", "content": 4}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 10}, {"type": "level", "content": "B2.1"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": "Identify and describe issues relating to money, in written and spoken situations according to work and social contexts."}, {"type": "secondary_1", "content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear."}, {"type": "secondary_2", "content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear."}, {"type": "secondary_3", "content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear."}, {"type": "secondary_4", "content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear."}, {"type": "secondary_5", "content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear."}, {"type": "secondary_6", "content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear."}, {"type": "secondary_7", "content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear."}, {"type": "secondary_8", "content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear."}]}, {"type": "background_image", "content": "engenn9le10ob04re1img01.jpg"}, {"type": "learning_points", "contents": [{"type": "heading", "content": " Tonic, Emphatic and New Information Stress "}, {"type": "describer", "content": "  Here we are looking at three types of stress, Tonic, emphatic, and stress for new information."}, {"type": "text", "content": "<span class=\"strong\">Tonic stress</span>  refers to the syllable in a word which receives the most stress in an intonation unit."}, {"type": "text", "content": "<span class=\"italic\">Example: </span> "}, {"type": "text", "content": "<span class=\"italic\">I was just a<span class=\"strong\">pproach</span>ed /</span><br/><span class=\"italic\">I was just a<span class=\"strong\">pproach</span>ed / by a re<span class=\"strong\">cruit</span>ment <span class=\"strong\">a</span>gency.</span> "}, {"type": "text", "content": "<span class=\"strong\">To emphasize</span>  a word, you can change the stress from the principal word to another content word. By choosing a word other than the one you normally stress, you put emphasis on the new one."}, {"type": "text", "content": "<span class=\"italic\">Example:</span> <br/> <span class=\"italic\">It was my first <span class=\"strong\">interview </span> here. - Standard statement </span> <br/> <span class=\"italic\">It was my <span class=\"strong\">first</span>  interview here - Emphasizes it was the first ever.</span> "}, {"type": "text", "content": "<span class=\"italic\">I tried to hard to impress and <span class=\"strong\">never </span> mentioned any weaknesses. </span> <br/> <span class=\"italic\">I tried to hard to impress and never mentioned any <span class=\"strong\">weaknesses</span> . </span> "}, {"type": "text", "content": "When you <span class=\"strong\">stress new information</span> , you pronounce new information with more breath force, since it is more prominent. "}, {"type": "text", "content": "<span class=\"italic\">They said it was an interview for a <span class=\"strong\">full-time </span>position.</span> <br/> <span class=\"italic\">Most of my experience has been with <span class=\"strong\">part-time</span> jobs.</span> "}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": " Reported Speech"}, {"type": "describer", "content": " You use reported speech when you are saying (reporting)  what other people said. "}, {"type": "text", "content": "When you tell people what someone has said in the past, you generally make the verb tense 'more in the past'. You need to change the verb to the next past form. "}, {"type": "text", "content": "For example:<br/> <span class=\"strong\">Direct speech</span><ul><li><span class=\"italic\">They are looking for someone to fill a new position.</span> </li> </ul><span class=\"strong\">Reported speech</span> <ul> <span class=\"italic\">They <span class=\"strong\">told</span>  me they were looking for someone to fill a new position. </span> "}, {"type": "text", "content": "When changing sentences from direct speech, check if you have to change the following:<ul> <li>pronouns (I said \u2192 He said)</li> <li>Present tense verbs </li> <li>Place and time expressions</li> <li>Tenses (backshift \u2192 change to the past)</li> "}, {"type": "text", "content": "Some reporting verbs and expressions commonly used are: <span class=\"strong\">say</span> , <span class=\"strong\">tell</span>, and <span class=\"strong\">ask</span> . "}, {"type": "example", "content": "They <span class=\"strong\">said </span> it was an interview for a full-time position."}, {"type": "example", "content": "They <span class=\"strong\">asked</span>  me what my strengths and weaknesses were."}, {"type": "example", "content": "They <span class=\"strong\">asked</span>  why I'd left my last job."}, {"type": "example", "content": "I <span class=\"strong\">told</span>  them straight out that I left because my ex-boss was a jerk. "}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to fill a position"}, {"type": "definition", "content": "to hire someone for a specific job"}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example:  They told me they were looking for someone to fill a new position. "}, {"type": "audio", "content": "engenn9le10ob04aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": " These are words you use to talk about a job interview."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "recruitment agency"}, {"type": "definition", "content": " a company that is paid to find workers for other companies"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: I was just approached by a recruitment agency."}, {"type": "audio", "content": "engenn9le10ob04aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "composed"}, {"type": "definition", "content": "calm and in control"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example:You're such a composed guy because you never appear to be nervous."}, {"type": "audio", "content": "engenn9le10ob04aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "overconfident"}, {"type": "definition", "content": " having too much confidence"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: I may have come off as a little overconfident."}, {"type": "audio", "content": "engenn9le10ob04aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "blowhard"}, {"type": "definition", "content": "a person who enjoys talking about how important they are"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: You don't want to be a blowhard."}, {"type": "audio", "content": "engenn9le10ob04aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "modest"}, {"type": "definition", "content": "quiet about one's abilities or achievements"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: A recruiter told me it's good to be modest and have a quiet confidence. "}, {"type": "audio", "content": "engenn9le10ob04aud06"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to put someone on the spot"}, {"type": "definition", "content": "to make someone uncomfortable by asking them to answer a difficult question"}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example: They asked why I'd left my last job. They put me on the spot."}, {"type": "audio", "content": "engenn9le10ob04aud07"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to beat around the bush"}, {"type": "definition", "content": "to speak indirectly about something"}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example: I tried not to beat around the bush by telling them straight out that I left because my ex-boss was a jerk. "}, {"type": "audio", "content": "engenn9le10ob04aud08"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to roll up your sleeves"}, {"type": "definition", "content": "to get to work"}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example: There are tons of jobs out there, so roll up your sleeves and let's get busy."}, {"type": "audio", "content": "engenn9le10ob04aud09"}]}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "You are going to interview and be interviewed by a partner."}, {"type": "text", "content": "Research job interview questions and choose 5 - 7 questions to ask"}, {"type": "text", "content": "Practice asking and answering questions with a partner."}, {"type": "text", "content": "When you are finished, give your partner some feedback."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I research job interview questions."}, {"type": "text", "content": "I ask and answer job interview questions."}, {"type": "text", "content": "I give my partner feedback on their answers."}]}]}