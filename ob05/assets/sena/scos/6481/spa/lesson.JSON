e": "group_name", "content": "Quiz"}]}, {"type": "feedback", "content": {"attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "correct_feedback": "Correct!", "allowed_attempts": 2, "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}]}, {"template_override": 1, "stimuli_ids": [], "questions": [{"responses": [{"correct": 1, "selected": 0, "id": 0, "_data": [{"type": "text", "content": ""}]}], "id": 0, "_data": [{"type": "question", "contents": [{"type": "pdf", "content": "engenn9le10ob05re7pdf01.pdf"}]}]}], "type": "DWS", "id": 11, "_data": [{"type": "instructions", "contents": [{"type": "text", "content": " \nFind a job posting and do a mock interview.\n"}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Take Away"}]}, {"type": "feedback", "content": {"attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "correct_feedback": "Correct!", "allowed_attempts": 2, "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"type": "learning_skills", "contents": [{"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Speaking"}]}, {"type": "post_instructions", "contents": [{"type": "text", "content": "\nInstructions: Complete the following steps. Fill in the Self Assessment.\n"}]}]}], "type": "scholar", "stimuli": [{"type": "welcome", "contents": [{}], "template_override": 1, "id": 0, "_data": []}, {"contents": [{"type": "slideshow", "value": {"coverimg": "engenn9le10ob05re2img05.jpg", "audiosrc": "engenn9le10ob05re2aud01", "images": [{"time": "0", "image": "engenn9le10ob05re2img05.jpg", "text": "", "id": 0}, {"time": "100", "image": "engenn9le10ob05re2img05.jpg", "text": "A friend's bad experience made me want to write and research more on this. I hope this research helps him and has him succeed in his next interview.<br />First, a lot of research needs to be done before the interview. Do your homework and find out as much as you can about the company and the job. Go further than just a quick look at the website. This will be useful when you are being asked questions. The job specifications should be studied carefully.", "id": 1}, {"time": "31000", "image": "engenn9le10ob05re2img07.jpg", "text": "Second, preparation and rehearsal are to be prioritized. Make sure preparation for likely questions is involved. Rehearse interview questions by yourself. Then, get a friend to ask you questions. Have them give you feedback on your answers.These are the best ways to manage your nerves.<br />Thirdly, questions about certain skills or experience are going to be asked. Have two to three successful stories up your sleeve. Make them work for you by making sure they focus on results.", "id": 2}, {"time": "64000", "image": "engenn9le10ob05re2img07.jpg", "text": "On the day of the interview, make sure you're punctual. Punctuality is seen as a sign of professionalism. Also, stay focused. It goes without saying that a successful interview is closely linked with being focused and displaying just the right amount of self-confidence. <br />Finally, make them believe you. Be yourself and do not pretend. And, before the interview is finished, ask a few smart final questions. The questions should be focused on the company and what the interviewers consider to be crucial skills for the job. <br /><br />Now, ace your interview and get hired!", "id": 3}]}}], "template_override": 1, "title": "", "type": "audio", "id": 1, "_data": []}], "id": 0, "_data": [{"type": "lab_options", "contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}]}]}]}