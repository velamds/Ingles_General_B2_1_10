t": {"attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "correct_feedback": "Correct!", "allowed_attempts": 2, "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"type": "learning_skills", "contents": [{"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Speaking"}]}, {"type": "post_instructions", "contents": [{"type": "text", "content": "\nInstructions: Complete the following steps. Fill in the Self Assessment.\n"}]}]}], "type": "scholar", "stimuli": [{"type": "welcome", "contents": [{}], "template_override": 1, "id": 0, "_data": []}, {"contents": [{"type": "slideshow", "value": {"coverimg": "engenn9le10ob10re2img05.jpg", "audiosrc": "engenn9le10ob10re2aud01", "images": [{"time": "0", "image": "engenn9le10ob10re2img05.jpg", "text": "", "id": 0}, {"time": "100", "image": "engenn9le10ob10re2img05.jpg", "text": "<span class= \"strong\"> Mark</span>: So, you told me your interview game is not up to snuff. Why is that?<br />\n<span class= \"strong\"> Adam</span>: I don't know. I'm a little rough around the edges. I could've used your help before but you said you were busy so I didn't bother asking. <br />\n<span class= \"strong\"> Mark</span>: Come on, Adam! We're friends. You should've told me you were having issues. I would've taken some time to assist with interviews.  You're earnest and eager, but you don't have the air of someone who can do it with one hand tied behind your back. <br />\n<span class= \"strong\"> Adam</span>: You're right. I could've called you. I just want to excel in my next interviews.<br />", "id": 1}, {"time": "29000", "image": "engenn9le10ob10re2img06.jpg", "text": "<span class= \"strong\"> Mark</span>: You will. And here's the first thing. Don't chew gum during the interview.<br />\n<span class= \"strong\"> Adam</span>: Got it. One recruiter at the job fair commented that it is rude. One thing I did at an interview was to say negative comments about my previous employer.<br />\n<span class= \"strong\"> Mark</span>: You shouldn't have said that. You could've mentioned that you left for personal reasons. <br />\n<span class= \"strong\"> Adam</span>: A friend suggested that I schedule my interviews in the morning. <br />\n<span class= \"strong\"> Mark</span>: Yes. A friend who works in HR observed that this is when you're likely to be successful and get the job. <br />\n<span class= \"strong\"> Adam</span>: I also brought up salary and benefits. <br />", "id": 2}, {"time": "60000", "image": "engenn9le10ob10re2img07.jpg", "text": "<span class= \"strong\"> Mark</span>: What? You could've kept your mouth shut. You should've waited until you got the job offer. <br />\n<span class= \"strong\"> Adam</span>: A friend remarked that I am always too early for the interview. I was one hour early for my last interview.<br />\n<span class= \"strong\"> Mark</span>:  You should've waited downstairs or outside. My father claimed that turning up five to 10 minutes is the sweet spot for interviews.<br />\n<span class= \"strong\"> Adam</span>:I feel like I've learned so much from you. <br />\n<span class= \"strong\"> Mark</span>: You would've benefited more had you contacted me earlier. I know a few companies that are hiring. I'll put in good words for you. <br />\n<span class= \"strong\"> Adam</span>: Thanks. Now, if you'll excuse me, I need to ace my next interview.<br />", "id": 3}]}}], "template_override": 1, "title": "", "type": "audio", "id": 1, "_data": []}, {"contents": [{"type": "p", "value": "Last week Sarah told me that she and Kate had been to separate interviews at the same publishing company. Kate commented that her interviewer was unprofessional because he was chewing gum. She also remarked that she didn't feel comfortable answering some of the questions he asked. Sarah's experience was completely different. She claimed that the interview was by far the most professional and positive experience. She told me that they offered her the job right on the spot."}], "template_override": 1, "title": "", "type": "text", "id": 2, "_data": []}], "id": 0, "_data": [{"type": "lab_options", "contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}]}]}]}